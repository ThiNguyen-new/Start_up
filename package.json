{
  "name": "survival-kit-hugo",
  "version": "1.0.0",
  "description": "Survival Kit - The Deadline Rescue Station (HCMUS)",
  "packageManager": "pnpm@12.15.0",
  "license": "MIT",
  "author": "Survival Kit Team (HCMUS)",
  "scripts": {
    "dev": "node server.js",
    "hugo:server": "hugo server",
    "build": "hugo --gc --minify --templateMetrics --templateMetricsHints --buildDrafts --buildExpired --buildFuture --forceSyncStatic",
    "preview": "hugo server --environment production --disableFastRender --minify -p 3000 --bind 0.0.0.0",
    "test": "node --test test/*.test.js && hugo --gc --minify",
    "test:unit": "node --test test/*.test.js",
    "project-setup": "node ./scripts/projectSetup.js",
    "theme-setup": "node ./scripts/themeSetup.js",
    "update-modules": "node ./scripts/clearModules.js && hugo mod clean --all && hugo mod get -u ./... && hugo mod tidy"
  }
}
